# ---- Anthropic / Claude (REQUIRED) ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
# claude-haiku-4-5 (cheap, for testing) or claude-opus-4-8 (best quality)
CLAUDE_MODEL=claude-haiku-4-5
ROUTER_MODEL=claude-haiku-4-5
MAX_TOKENS=2048

# ---- MongoDB (source data) ----
# Local Mongo needs no auth. MongoDB Atlas: put user:pass in the URI.
# Recommended: use a READ-ONLY database user for this app.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB=toms
# Rows returned by a generated query are hard-capped at this count.
MAX_RESULT_DOCS=50

# ---- Semantic path: embeddings (torch-free, no key) + vector store ----
# Collections embedded for semantic search (comma-separated).
RAG_COLLECTIONS=tickets,feedbackresponses,topic_tracker_entries,subjects
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./chroma_store
RETRIEVER_K=4
# Optional: avoids HuggingFace 403s from anonymous-traffic rate limits
# (common on corporate networks). Get a free "Read" token at
# huggingface.co -> Settings -> Access Tokens.
HF_TOKEN=

# ---- LangSmith tracing (OPTIONAL) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=myagent

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
